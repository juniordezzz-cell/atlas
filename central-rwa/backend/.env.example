# Copie para .env (que NUNCA vai para o git) para rodar localmente.
# No GitHub Actions, os mesmos nomes são cadastrados em Settings → Secrets → Actions.

# Obrigatória para gravar (sem ela, use --dry-run).
# Supabase → Project Settings → Database → Connection string (modo pooler).
SUPABASE_DB_URL=

# Opcionais — RPC com chave para ler a Aero pelo Sugar. Vazio = RPC pública da rede.
ATLAS_RPC_BASE=
ATLAS_RPC_OPTIMISM=
ATLAS_RPC_ETHEREUM=
ATLAS_RPC_ARBITRUM=
